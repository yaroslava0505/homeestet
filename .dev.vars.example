# Local variables for `npm run dev:cf` (wrangler pages dev). Copy to .dev.vars (git-ignored).

# Real analysis: your Anthropic API key (console.anthropic.com → API keys).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: another model id. Default claude-haiku-4-5 (cheapest); claude-sonnet-5 is the quality step up.
# ANALYSIS_MODEL=claude-sonnet-5

# Canned answer without calling the model, for UI work:
ANALYSIS_MOCK=1
